# Backend Environment Variables (copy to backend/.env)
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/timora_db
JWT_SECRET=replace_with_at_least_32_char_cryptographic_secret_key_2026
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads/cvs
GEMINI_API_KEY=

# Frontend Environment Variables (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

